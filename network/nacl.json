{
  "inbound": [
    {"rule": 90,  "protocol": "all", "cidr": "198.51.100.0/24", "action": "deny",
     "comment": "known abusive range: everything, even web ports; lowest number so it wins"},
    {"rule": 100, "protocol": "tcp", "port_from": 80,   "port_to": 80,    "cidr": "0.0.0.0/0",      "action": "allow",
     "comment": "HTTP from anywhere"},
    {"rule": 110, "protocol": "tcp", "port_from": 443,  "port_to": 443,   "cidr": "0.0.0.0/0",      "action": "allow",
     "comment": "HTTPS from anywhere"},
    {"rule": 120, "protocol": "tcp", "port_from": 22,   "port_to": 22,    "cidr": "10.20.5.128/27", "action": "allow",
     "comment": "SSH only from the management subnet"},
    {"rule": 130, "protocol": "tcp", "port_from": 1024, "port_to": 65535, "cidr": "10.20.0.0/22",   "action": "allow",
     "comment": "replies from the app subnet to the load balancer's ephemeral ports"}
  ],
  "outbound": [
    {"rule": 100, "protocol": "tcp", "port_from": 8000, "port_to": 8000,  "cidr": "10.20.0.0/22",   "action": "allow",
     "comment": "load balancer -> app service on TCP 8000"},
    {"rule": 110, "protocol": "tcp", "port_from": 1024, "port_to": 65535, "cidr": "0.0.0.0/0",      "action": "allow",
     "comment": "replies to clients' ephemeral ports, anywhere"}
  ]
}
